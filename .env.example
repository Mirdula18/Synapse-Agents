# Synapse Agents — Environment Variables
# Copy to .env and adjust as needed.

# --- Authentication ---
# If set, all API requests must include X-API-Key header.
# SYNAPSE_API_KEY=your-secret-key

# --- Runtime Mode ---
# "development" (default) or "production".
# SYNAPSE_ENV=development

# --- CORS ---
# Comma-separated allowed origins. In development, localhost defaults are used.
# In production with credentials enabled, explicit origins are required.
# SYNAPSE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Enable credentialed CORS (default: true). Wildcard "*" is rejected when true.
# SYNAPSE_CORS_ALLOW_CREDENTIALS=true

# --- LLM / Ollama ---
# Default model used by API/UI when not overridden in request.
# SYNAPSE_DEFAULT_MODEL=mistral

# Connect timeout in seconds (minimum: 1, default: 10).
# OLLAMA_CONNECT_TIMEOUT_S=10

# Read timeout in seconds (minimum: 5, default: 60).
# OLLAMA_READ_TIMEOUT_S=60

# Number of retry attempts on LLM failure (minimum: 1, default: 1).
# OLLAMA_RETRIES=1

# Initial retry backoff in seconds, doubles each attempt (range: 0.1-120, default: 1.5).
# OLLAMA_RETRY_BACKOFF_S=1.5

# Max token budget per generation (minimum: 64, default: 520).
# OLLAMA_NUM_PREDICT=520

# LLM sampling temperature (range: 0.0-2.0, default: 0.2).
# OLLAMA_TEMPERATURE=0.2

# --- API ---
# Default limit for GET /history (minimum: 1, default: 20).
# SYNAPSE_HISTORY_LIMIT=20

# Hours to retain async job records before cleanup (minimum: 1, default: 24).
# SYNAPSE_ASYNC_JOB_RETENTION_HOURS=24

# --- Execution Sandbox ---
# Set to "true" to enable safe_shell execution (default: false).
# When disabled, safe_shell is a no-op that always returns an error.
# SYNAPSE_ENABLE_EXEC=false

# --- Workers ---
# Max concurrent threads for async job execution (minimum: 1, default: 2).
# SYNAPSE_MAX_WORKERS=2

# --- Knowledge Base ---
# Minimum quality score (0.0-1.0) to store knowledge from research steps (default: 0.5).
# SYNAPSE_KB_MIN_QUALITY=0.5

# Maximum knowledge base entries. Prune oldest/lowest-quality when exceeded (default: 1000).
# SYNAPSE_KB_MAX_ENTRIES=1000

# --- Database ---
# Optional: override SQLite database path (default: data/synapse_memory.db).
# For Postgres support, set DATABASE_URL to a connection string.
# DATABASE_URL=postgresql://user:pass@localhost:5432/synapse
